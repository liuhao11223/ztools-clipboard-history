    },
    {
      "code": "clipboard-search",
      "explain": "在主搜索框检索剪切板历史",
      "mainPush": true,
      "cmds": [
        {
          "type": "over",
          "label": "剪切板历史",
          "minLength": 1,
          "maxLength": 80
        }
      ]
    }
  ],
  "pluginSetting": {
    "single": false
  }
}
